@model DisasterMIS_Frontend.Models.IncidentModel
@{
    ViewData["Title"] = "Report Incident";
}
<h2>Report New Incident</h2>
@if (ViewBag.Success != null)
{
    <div class="alert alert-success">@ViewBag.Success</div>
}
<form method="post">
    <div class="form-group">
        <label>Location</label>
        <input asp-for="Location" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Latitude</label>
        <input asp-for="Latitude" class="form-control" step="any" required />
    </div>
    <div class="form-group">
        <label>Longitude</label>
        <input asp-for="Longitude" class="form-control" step="any" required />
    </div>
    <div class="form-group">
        <label>Disaster Type</label>
        <select asp-for="DisasterType" class="form-control">
            <option>Flood</option>
            <option>Earthquake</option>
            <option>Fire</option>
            <option>Hurricane</option>
            <option>Other</option>
        </select>
    </div>
    <div class="form-group">
        <label>Severity Level</label>
        <select asp-for="SeverityLevel" class="form-control">
            <option>Low</option>
            <option>Medium</option>
            <option>High</option>
            <option>Critical</option>
        </select>
    </div>
    <div class="form-group">
        <label>Priority (1-5)</label>
        <input asp-for="PriorityLevel" type="number" min="1" max="5" class="form-control" />
    </div>
    <div class="form-group">
        <label>Reporter Contact (optional)</label>
        <input asp-for="ReporterContact" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Submit Report</button>
</form>
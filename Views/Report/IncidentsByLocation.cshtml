@using System.Data
@using System.Text.Json
@model DataTable
@{
    ViewData["Title"] = "Incident Statistics";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">📊 Incident Statistics by Location & Severity</h2>
    <a asp-action="ExportToExcel" asp-route-reportType="Incidents" class="btn btn-success">
        <i class="bi bi-file-excel"></i> Export to Excel
    </a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-bar-chart"></i> Chart View</h5>
            </div>
            <div class="card-body">
                <canvas id="incidentChart" style="max-width: 100%; height: 400px;"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-table"></i> Data View</h5>
            </div>
            <div class="card-body" style="max-height: 450px; overflow-y: auto;">
                @if (Model.Rows.Count == 0)
                {
                    <div class="alert alert-info">No incident data available.</div>
                }
                else
                {
                    <table class="table table-striped table-bordered table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th>Location</th>
                                <th>Disaster Type</th>
                                <th>Severity Level</th>
                                <th>Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DataRow row in Model.Rows)
                            {
                                <tr>
                                    <td>@row["Location"]</td>
                                    <td>@row["DisasterType"]</td>
                                    <td>@row["SeverityLevel"]</td>
                                    <td><strong>@row["IncidentCount"]</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Prepare data for chart
        const labels = @Html.Raw(JsonSerializer.Serialize(Model.AsEnumerable().Select(r => r["Location"].ToString()).ToArray()));
        const data = @Html.Raw(JsonSerializer.Serialize(Model.AsEnumerable().Select(r => Convert.ToInt32(r["IncidentCount"])).ToArray()));

        // Create chart
        const ctx = document.getElementById('incidentChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Number of Incidents',
                    data: data,
                    backgroundColor: 'rgba(230, 126, 34, 0.7)',
                    borderColor: '#e67e22',
                    borderWidth: 1,
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'top',
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return `Incidents: ${context.raw}`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Number of Incidents',
                            font: { weight: 'bold' }
                        },
                        grid: {
                            color: 'rgba(0,0,0,0.05)'
                        }
                    },
                    x: {
                        title: {
                            display: true,
                            text: 'Location',
                            font: { weight: 'bold' }
                        },
                        ticks: {
                            rotate: 45,
                            autoSkip: true,
                            maxRotation: 45,
                            minRotation: 45
                        }
                    }
                }
            }
        });
    </script>
}
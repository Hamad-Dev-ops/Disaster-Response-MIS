@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Field Dashboard";
}

<h2>📍 Field Operations Dashboard</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-info">No active incidents at this time.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Incident ID</th>
                    <th>Location</th>
                    <th>Disaster Type</th>
                    <th>Severity</th>
                    <th>Status</th>
                    <th>Reported Time</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow row in Model.Rows)
                {
                    <tr>
                        <td>@row["IncidentID"]</td>
                        <td>@row["Location"]</td>
                        <td>@row["DisasterType"]</td>
                        <td>@row["SeverityLevel"]</td>
                        <td>
                            @{
                                string status = row["Status"].ToString();
                                string badgeClass = status == "Reported" ? "bg-warning" : (status == "Assigned" ? "bg-info" : (status == "InProgress" ? "bg-primary" : "bg-secondary"));
                            }
                            <span class="badge @badgeClass">@status</span>
                        </td>
                        <td>@row["TimeReported"]</td>
                        <td>
                            <a asp-action="UpdateStatus" asp-route-id="@row["IncidentID"]" class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil"></i> Update
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}